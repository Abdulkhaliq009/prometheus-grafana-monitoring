# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored — it will never be committed.

# Gmail address Grafana will send alert emails FROM (and sign into SMTP as).
GF_SMTP_USER=your-email@gmail.com

# A Gmail App Password (NOT your normal Gmail password — Gmail blocks plain
# password SMTP logins). Generate one at:
#   https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first)
GF_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
